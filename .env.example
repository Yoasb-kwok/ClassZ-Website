# Backend API origin only — no trailing slash, no /api suffix.
#
# LOCAL DEV (required): start classz-api first, then Next.js
#   Terminal 1: cd classz-api && npm start          → http://localhost:3003
#   Terminal 2: cd ClassZ-website && npm run dev    → http://localhost:3000
BACKEND_URL=http://localhost:3003
NEXT_PUBLIC_CLASSZ_API_URL=http://localhost:3003

# Production (temporary Railway domain during cutover):
# BACKEND_URL=https://classz-api-production.up.railway.app
# NEXT_PUBLIC_CLASSZ_API_URL=https://classz-api-production.up.railway.app
#
# Production (custom domain after Railway SSL is active):
# BACKEND_URL=https://api.new.classz.co
# NEXT_PUBLIC_CLASSZ_API_URL=https://api.new.classz.co
#
# Optional alias (checked first in lib/backend-origin and some routes)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3003

