# Backend API origin only — no trailing slash, no /api suffix.
# Examples:
#   ClassZ API (local, separate from Yard): http://localhost:3003
# Next.js browser → classz-api (login + admin stats when wired):
# NEXT_PUBLIC_CLASSZ_API_URL=http://localhost:3003
#   ClassZ prod: https://api.classz.co
#   Yard:        https://theyardapis.01tech.work
#
# Existing route handlers (e.g. loginfordelete) and this catch-all proxy both use this.
BACKEND_URL=https://api.classz.co

# Optional alias (checked first in lib/backend-origin and some routes)
# NEXT_PUBLIC_API_BASE_URL=https://api.classz.co

